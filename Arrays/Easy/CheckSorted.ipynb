   ],
   "source": [
    "def isSorted(arr):\n",
    "    for i in range(len(arr) - 1):\n",
    "        if arr[i] >= arr[i+1]:\n",
    "            return False\n",
    "\n",
    "    return True\n",
    "\n",
    "arr = [1, 2, 5, 8]\n",
    "print(isSorted(arr))"
   ]
  }
