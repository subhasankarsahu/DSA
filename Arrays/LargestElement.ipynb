   "source": [
    "def largestElement(arr):\n",
    "    largest = arr[0]\n",
    "\n",
    "    for i in range(len(arr)):\n",
    "        if arr[i] > largest:\n",
    "            largest = arr[i]\n",
    "\n",
    "    return largest\n",
    "\n",
    "arr = [5, 1, 3, 7, 4, 2]\n",
    "print(largestElement(arr))"
   ]
  }
